{
  "version": 1,
  "filesystem_policy": {
    "include_workdir": false,
    "read_only": [
      "/usr",
      "/lib",
      "/lib64",
      "/app"
    ],
    "read_write": [
      "/tmp"
    ]
  },
  "landlock": {
    "compatibility": "hard_requirement"
  },
  "process": {
    "run_as_user": "sandbox",
    "run_as_group": "sandbox"
  },
  "network_policies": {},
  "network_middlewares": {}
}
